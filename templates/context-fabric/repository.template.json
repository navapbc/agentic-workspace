{
  "_comment": "REPOSITORY RESOURCE template. Identity and checkout facts for ONE repo, defined once even if many products use it. Product-specific meaning belongs in profiles, not here. Remove all _comment fields before saving.",
  "kind": "repositoryResource",
  "id": "repository:{{org}}/{{repo}}",
  "schemaVersion": "1.0.0",
  "updatedAt": "{{YYYY-MM-DDTHH:MM:SSZ}}",
  "system": "system:{{hosting-system-slug}}",
  "url": "https://{{host}}/{{org}}/{{repo}}",
  "lifecycle": "{{active | anticipated | unavailable | deprecated | retired | excluded}}",
  "accessState": "{{accessible | request-required | unavailable}}",
  "syncable": true,
  "provenance": {
    "source": "{{where this fact came from}}",
    "addedBy": "{{name}}"
  },
  "validation": {
    "validatedBy": "{{name}}",
    "validatedAt": "{{YYYY-MM-DDTHH:MM:SSZ}}"
  }
}
