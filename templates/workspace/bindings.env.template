# Portable path bindings for this workspace.
#
# Copy this file to `bindings.env` and set the values for YOUR machine.
# Skills and workflows reference ${THESE_NAMES} instead of hardcoded absolute paths,
# so the same workspace works on every teammate's machine.
#
# NEVER commit or share a filled-in bindings.env. Share only this .template.
# Do not put secrets here. Inject secrets at runtime (e.g. `op run`), never store them.
# (If your workspace folder name contains spaces, quote the values.)

WORKSPACE_ROOT=/absolute/path/to/{{WORKSPACE_NAME}}
SUPPORT_ROOT=${WORKSPACE_ROOT}/agentic-support
PRODUCT_WORK_ROOT=${WORKSPACE_ROOT}/canonical
PROTOTYPE_ROOT=${WORKSPACE_ROOT}/prototyping

# Where cloned code repos live on your machine (OUTSIDE the workspace):
REPO_CHECKOUT_ROOT=/absolute/path/to/repo-checkouts
